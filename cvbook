#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""无需安装，直接运行::

    ./cvbook 某书.md
    ./cvbook -s my-style.css 某书.md

这个入口只把 ``src/`` 加进 ``sys.path``，然后调用 ``cvbook.cli``。
"""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "src"))

from cvbook.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
