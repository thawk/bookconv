#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""无需安装，直接在项目目录里运行::

    ./bookconv 某书.md
    ./bookconv -s my-style.css 某书.md

依赖（ebooklib / markdown）装在项目内的 ``.venv`` 里（见 README）：

    python3 -m venv .venv
    .venv/bin/pip install -e .

这个入口如果发现有 ``.venv``，会用它里面的解释器重新执行自己；没有就退回
当前解释器（这时依赖得装在系统 Python 里）。
"""

import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
VENV_PYTHON = os.path.join(HERE, ".venv", "bin", "python")

if os.path.exists(VENV_PYTHON) and os.path.abspath(sys.executable) != VENV_PYTHON:
    os.execv(VENV_PYTHON, [VENV_PYTHON, os.path.abspath(__file__)] + sys.argv[1:])

sys.path.insert(0, os.path.join(HERE, "src"))

from bookconv.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
